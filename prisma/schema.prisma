generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProductStatus {
  DRAFT
  PUBLISHED
}

enum OrderStatus {
  RESERVED
  EXPIRED
  CANCELED
}

enum MockPaymentOutcome {
  APPROVED
  DECLINED
}

enum BlogStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model Category {
  id           String                @id @default(cuid())
  name         String
  slug         String                @unique
  description  String?
  translations Json?
  parentId     String?
  parent       Category?             @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children     Category[]            @relation("CategoryTree")
  attributes   AttributeDefinition[]
  products     Product[]
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  @@index([parentId])
}

model Brand {
  id           String    @id @default(cuid())
  name         String
  slug         String    @unique
  description  String?
  translations Json?
  active       Boolean   @default(true)
  products     Product[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([active, name])
}

model AttributeDefinition {
  id         String   @id @default(cuid())
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  key        String
  label      String
  type       String
  required   Boolean  @default(false)
  options    Json?
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([categoryId, key])
  @@index([categoryId, sortOrder])
}

model Product {
  id           String        @id @default(cuid())
  brandId      String?
  brand        Brand?        @relation(fields: [brandId], references: [id], onDelete: SetNull)
  categoryId   String
  category     Category      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  slug         String        @unique
  name         String
  description  String        @db.Text
  translations Json?
  attributes   Json          @default("{}")
  images       String[]      @default([])
  featured     Boolean       @default(false)
  status       ProductStatus @default(DRAFT)
  variants     Variant[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([categoryId, status])
  @@index([brandId, status])
  @@index([status, featured])
  @@index([name])
}

model Variant {
  id         String      @id @default(cuid())
  productId  String
  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku        String      @unique
  name       String
  priceMinor Int
  currency   String      @default("USD") @db.VarChar(3)
  stock      Int         @default(0)
  attributes Json        @default("{}")
  orderLines OrderLine[]
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@index([productId])
}

model Customer {
  id           String   @id @default(cuid())
  email        String   @unique @db.VarChar(254)
  passwordHash String
  name         String   @db.VarChar(160)
  phone        String   @db.VarChar(40)
  orders       Order[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Order {
  id                 String           @id @default(cuid())
  idempotencyKey     String           @unique @db.VarChar(128)
  requestFingerprint String           @db.VarChar(64)
  status             OrderStatus      @default(RESERVED)
  customerSnapshot   Json
  addressSnapshot    Json
  currency           String           @db.VarChar(3)
  subtotalMinor      BigInt
  shippingMinor      BigInt
  taxMinor           BigInt
  totalMinor         BigInt
  shippingPolicy     String           @db.VarChar(100)
  taxPolicy          String           @db.VarChar(100)
  expiresAt          DateTime
  releasedAt         DateTime?
  customerId         String?
  customer           Customer?        @relation(fields: [customerId], references: [id], onDelete: SetNull)
  paymentAttempts    PaymentAttempt[]
  lines              OrderLine[]
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@index([status, expiresAt])
  @@index([createdAt])
  @@index([customerId, createdAt])
}

model PaymentAttempt {
  id          String             @id @default(cuid())
  orderId     String
  order       Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  attemptKey  String             @unique @db.VarChar(128)
  outcome     MockPaymentOutcome
  amountMinor BigInt
  currency    String             @db.VarChar(3)
  createdAt   DateTime           @default(now())

  @@index([orderId, createdAt])
}

model OrderLine {
  id                  String   @id @default(cuid())
  orderId             String
  order               Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId           String?
  variant             Variant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  productNameSnapshot String
  variantNameSnapshot String
  skuSnapshot         String
  quantity            Int
  reservedRemaining   Int
  unitPriceMinor      Int
  lineTotalMinor      BigInt
  currency            String   @db.VarChar(3)

  @@index([variantId, orderId])
  @@index([orderId])
}

model HomePageContent {
  id           String   @id @default("home")
  translations Json
  updatedAt    DateTime @updatedAt
}

model BlogPost {
  id                  String     @id @default(cuid())
  slug                String     @unique
  status              BlogStatus @default(DRAFT)
  coverImage          String
  coverAlt            String
  tags                String[]   @default([])
  relatedPostSlugs    String[]   @default([])
  relatedProductSlugs String[]   @default([])
  translations        Json
  publishedAt         DateTime?
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  @@index([status, publishedAt])
  @@index([updatedAt])
}
