{
  "name": "sarfe-store",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts tests/*.test.tsx",
    "test:postgres": "SARFE_TEST_POSTGRES=1 node --conditions=react-server --import tsx --test --test-concurrency=1 tests/orders-postgres.test.ts tests/catalog-postgres.test.ts tests/customer-orders-postgres.test.ts tests/admin-orders-postgres.test.ts tests/mock-payments-postgres.test.ts tests/blog-postgres.test.ts tests/identity-login.postgres.ts",
    "db:validate": "prisma validate",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:local:start": "scripts/local-db-start",
    "db:local:status": "scripts/local-db-status",
    "db:local:stop": "scripts/local-db-stop",
    "admin:hash": "tsx scripts/hash-admin-password.ts"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "clsx": "^2.1.1",
    "jose": "^6.1.3",
    "lucide-react": "^0.468.0",
    "next": "16.4.5",
    "prisma": "6.19.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.4.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.39.1",
    "eslint-config-next": "16.4.5",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
