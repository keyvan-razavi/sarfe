DATABASE_URL="postgresql://sarfe:sarfe@localhost:5432/sarfe_store?schema=public"
SESSION_SECRET="replace-with-at-least-32-random-characters"
ADMIN_EMAIL="owner@example.com"
ADMIN_PASSWORD_HASH="generate-with-npm-run-admin:hash"
APP_URL="http://localhost:3000"
CHECKOUT_POLICY_ID=""
CHECKOUT_POLICY_CURRENCY="IRR"
CHECKOUT_SHIPPING_MINOR=""
CHECKOUT_SHIPPING_POLICY=""
CHECKOUT_TAX_MINOR=""
CHECKOUT_TAX_POLICY=""
CHECKOUT_ENABLED="false"
# Local-only mock payment UI. Requires NODE_ENV != production and this exact value.
# It records simulated outcomes only; no funds move and orders remain RESERVED.
MOCK_PAYMENTS_ENABLED="false"
# For a local review: set MOCK_PAYMENTS_ENABLED="true" in .env, run
# `npx prisma migrate deploy` and `npm run db:generate`, then restart `npm run dev`.
# With checkout policy values empty, local checkout uses visibly labeled zero
# shipping/tax demo estimates; this is not the store's real checkout policy.
